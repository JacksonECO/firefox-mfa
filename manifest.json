{
  "manifest_version": 3,
  "name": "MFA Num Toque",
  "version": "1.0.0",
  "description": "Gerenciador local de códigos MFA (TOTP), com foco no domínio atual e segredos sempre criptografados em repouso.",
  "author": "Jackson Silveira",
  "browser_specific_settings": {
    "gecko": {
      "id": "mfa-num-toque@jacksoneco",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "clipboardWrite",
    "scripting"
  ],
  "action": {
    "default_title": "MFA Num Toque",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
