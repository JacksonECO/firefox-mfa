{
  "manifest_version": 3,
  "name": "Firefox MFA",
  "version": "0.1.0",
  "description": "Gerenciador local de códigos MFA (TOTP), com foco no domínio atual e segredos sempre criptografados em repouso.",
  "browser_specific_settings": {
    "gecko": {
      "id": "firefox-mfa@local",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "clipboardWrite"
  ],
  "action": {
    "default_title": "Firefox MFA",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "background": {
    "scripts": ["src/background.js"],
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
